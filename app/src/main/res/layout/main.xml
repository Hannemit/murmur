<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_dim"
            android:textSize="15sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/toggle"
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:background="@drawable/toggle"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/sound_airplane"
            style="@style/SoundChoice"
            android:text="@string/sound_airplane" />

        <TextView
            android:id="@+id/sound_fan"
            style="@style/SoundChoice"
            android:text="@string/sound_fan" />

        <TextView
            android:id="@+id/sound_white"
            style="@style/SoundChoice"
            android:text="@string/sound_white" />
    </LinearLayout>
</ScrollView>
